# ===========================================
# Outlaws Bot — Environment Variables
# Copy this file to .env and fill in the values.
# On Render: set these in the Dashboard → Environment
# ===========================================

# Required
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# MongoDB (required)
# Render: use MongoDB Atlas free cluster connection string
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/outlaws?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/outlaws

# Optional
# PORT is set automatically by Render (default 10000)
# PORT=10000
